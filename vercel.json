{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/includes/(.*)", "status": 404 },
    { "src": "/api/404\\.php", "status": 404 },
    { "src": "/api/gemini\\.php", "dest": "/api/gemini.php" },
    { "src": "/", "dest": "/api/index.php?__rota=index.php" },
    { "src": "/(.*)\\.php", "dest": "/api/index.php?__rota=$1.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php?__rota=$1" }
  ]
}
